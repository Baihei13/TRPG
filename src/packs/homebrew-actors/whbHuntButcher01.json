    {
      "_id": "whbBtcBanish0001",
      "img": "systems/pf2e/icons/actions/Passive.webp",
      "name": "尸体驱逐（赏金）",
      "sort": 800000,
      "type": "action",
      "system": {
        "actionType": {
          "value": "passive"
        },
        "actions": {
          "value": null
        },
        "category": "interaction",
        "description": {
          "value": "<p>死亡后尸体可被<strong>驱逐</strong>（Banish）：通常需 1 分钟专注仪式或场景目标互动（GM 裁定）。驱逐完成后发放赏金标记 / 特性残渣（可与死神熊、肉头怪类似掷 1d8），并在赏金冲突模式中作为可争夺目标。</p>"
        },
