    {
      "_id": "whbMthSlam000001",
      "img": "systems/pf2e/icons/default-icons/melee.svg",
      "name": "肥躯撞击",
      "sort": 200000,
      "type": "melee",
      "system": {
        "action": { "value": "" },
        "attackEffects": { "custom": "", "value": ["push"] },
        "bonus": { "value": 13 },
        "damageRolls": {
          "whbMthDmgSlam001": {
