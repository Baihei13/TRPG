    },
    {
      "_id": "whbArmStalk00001",
      "img": "systems/pf2e/icons/actions/Passive.webp",
      "name": "潜行与冲锋",
      "sort": 510000,
      "type": "action",
      "system": {
        "actionType": { "value": "passive" },
        "actions": { "value": null },
        "category": "offensive",
        "description": {
          "value": "<p>未警觉时以步行速度游荡（速度 20 尺）。一旦察觉猎人并进入敌对，进入<strong>冲锋态</strong>：速度变为 30 尺，并会撞开关闭的门（见「撞门」）。</p>\n<p>冲锋态持续至战斗结束，或连续 1 分钟无法感知任何敌人。</p>"
        },
        "publication": {
          "title": "猎杀对决 — 怪物",
          "authors": "Wang Homebrew / Hunt: Showdown",
          "license": "ORC",
          "remaster": true
        },
        "rules": [],
        "slug": null,
        "traits": { "value": [] }
      }
    },
    {
      "_id": "whbArmBreakDoor1",
      "img": "systems/pf2e/icons/actions/OneAction.webp",
      "name": "撞门",
      "sort": 600000,
      "type": "action",
      "system": {
        "actionType": { "value": "action" },
        "actions": { "value": 1 },
        "category": "interaction",
        "description": {
          "value": "<p><strong>要求</strong> 处于冲锋态</p>\n<p>对邻接的门、简单木障或类似障碍尝试 @Check[athletics|dc:15]{运动 DC 15}（寻常木门）或由 GM 定 DC。成功则破开并进入该空间；大成功不引发额外噪音惩罚（仍可能被听见）。</p>"
        },
        "publication": {
          "title": "猎杀对决 — 怪物",
          "authors": "Wang Homebrew / Hunt: Showdown",
          "license": "ORC",
          "remaster": true
        },
