          ]
        }
      }
    },
    {
      "_id": "whbWhHandcuff001",
      "img": "systems/pf2e/icons/actions/Reaction.webp",
      "name": "不可靠则铐回",
      "sort": 420000,
      "type": "action",
      "system": {
        "actionType": {
          "value": "reaction"
        },
        "actions": {
          "value": null
        },
        "category": "defensive",
        "description": {
          "value": "<p><strong>触发</strong> 30 尺内一个你曾视为「囚犯猎人/不可靠」的生物对你造成伤害，或试图逃跑/遁入隐蔽</p>\n<p>立刻对其发动一次黄铜花或和平缔造者打击，或 Stride 至邻接后尝试重新逮捕（仍耗反应，该次逮捕视为 1 动作版：仅擒抱，不升束缚）。每场遭遇 1 次。</p>"
        },
        "publication": {
          "title": "猎杀对决 — 猎人",
          "authors": "Wang Homebrew / Hunt: Showdown",
          "license": "ORC",
          "remaster": true
        },
