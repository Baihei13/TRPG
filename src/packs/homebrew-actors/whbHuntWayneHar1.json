        }
      }
    },
    {
      "_id": "whbWhTactics0001",
      "img": "systems/pf2e/icons/actions/Passive.webp",
      "name": "哈丁战术（GM）",
      "sort": 900000,
      "type": "action",
      "system": {
        "actionType": {
          "value": "passive"
        },
        "actions": {
          "value": null
        },
        "category": "offensive",
        "description": {
          "value": "<p><strong>定位</strong>：执法警长，远距卡宾 + 双左轮控场。疫情老手，囚犯猎人克星。</p>\n<ol>\n<li>绞索远点减速，点名威胁</li>\n<li>和平缔造者真射收威胁</li>\n<li>贴身黄铜花 / 重拳；半血叠危急</li>\n<li>不可靠则铐回 + 重新逮捕</li>\n</ol>"
        },
        "publication": {
          "title": "猎杀对决 — 猎人",
          "authors": "Wang Homebrew / Hunt: Showdown",
          "license": "ORC",
          "remaster": true
        },
