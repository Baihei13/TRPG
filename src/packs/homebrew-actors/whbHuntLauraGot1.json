    {
      "_id": "whbLrGhillie0001",
      "img": "systems/pf2e/icons/actions/Passive.webp",
      "name": "枯枝伪装",
      "sort": 800000,
      "type": "action",
      "system": {
        "actionType": { "value": "passive" },
        "actions": { "value": null },
        "category": "defensive",
        "description": {
          "value": "<p>肩头枯枝与粗麻兜帽打散轮廓。在自然地形中，Stealth 与 Hide 相关检定获得 <strong>+2 环境加值</strong>；若她未移动且有部分掩体，察觉她的 Perception DC 视为提高 2。</p>"
