    {
      "_id": "whbEkIronclad001",
      "img": "systems/pf2e/icons/actions/Reaction.webp",
      "name": "铁甲战士",
      "sort": 400000,
      "type": "action",
      "system": {
        "actionType": {
          "value": "reaction"
        },
        "actions": {
          "value": null
        },
        "category": "defensive",
        "description": {
          "value": "<p><strong>触发</strong> 他受到物理伤害</p>\n<p>钢板与头盔吃掉冲击：该次伤害减少 <strong>5</strong>（在抗性之后结算）。每轮限 1 次。</p>\n<p>他们称他为铁甲战士是有原因的。</p>"
        },
        "publication": {
