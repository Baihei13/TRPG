    {
      "_id": "whbEkFightBack01",
      "img": "modules/wang-pf2e-homebrew/assets/hunt/regeneration-shot.png",
      "name": "奋起反击",
      "sort": 300000,
      "type": "action",
      "system": {
        "actionType": {
