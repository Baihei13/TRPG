    {
      "_id": "whbWlTactics0001",
      "img": "systems/pf2e/icons/actions/Passive.webp",
      "name": "惠特洛战术（GM）",
      "sort": 900000,
      "type": "action",
      "system": {
        "actionType": {
          "value": "passive"
        },
        "actions": {
          "value": null
        },
        "category": "offensive",
        "description": {
          "value": "<p><strong>定位</strong>：第26团指挥官，偏执中距火力。比里金斯更强、更不稳。</p>\n<ol>\n<li><strong>战场军法</strong>点名「逃兵」再正当程序审判</li>\n<li>近距用自由之歌连射或对应物协议条款</li>\n<li>贴身骑兵佩剑收尾</li>\n<li>半血打强大的宪法；重击后注意荣耀之梦敌视盟友</li>\n</ol>\n<p>他组建叛军来救侦察兵——如今枪口对准一切让他手抖的人。</p>"
        },
        "publication": {
          "title": "猎杀对决 — 猎人",
          "authors": "Wang Homebrew / Hunt: Showdown",
          "license": "ORC",
          "remaster": true
        },
        "rules": [],
        "slug": "whitlaw-tactics",
        "traits": {
          "value": []
        }
      }
