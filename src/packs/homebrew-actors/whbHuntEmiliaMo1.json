    {
      "_id": "whbEmTactics0001",
      "img": "systems/pf2e/icons/actions/Passive.webp",
      "name": "狩猎教义（GM）",
      "sort": 900000,
      "type": "action",
      "system": {
        "actionType": {
          "value": "passive"
        },
        "actions": {
          "value": null
        },
        "category": "offensive",
        "description": {
          "value": "<p><strong>与劳拉对比</strong>：劳拉远距消音风筝；艾米莉亚是<strong>中距双枪猎人</strong>——步枪开场，双枪贴身齐射，斧与陷阱收尾。</p>\n<ol>\n<li>开场 <strong>猎物印记</strong> + 步枪点射</li>\n<li>逼近后 <strong>双牙齐射</strong> 压制；空枪时甩 <strong>投掷斧</strong></li>\n<li>预布 <strong>林间陷阱</strong>，把人赶进夹口</li>\n<li>猎物惊惧/流血后 <strong>狼途追猎</strong> + 剥皮短刃收割</li>\n</ol>\n<p>理想交战：30～80 尺；进入 50 尺内优先双枪。</p>"
        },
        "publication": {
          "title": "猎杀对决 — 猎人",
          "authors": "Wang Homebrew / Hunt: Showdown",
          "license": "ORC",
          "remaster": true
        },
        "rules": [],
        "slug": "emilia-tactics",
        "traits": {
