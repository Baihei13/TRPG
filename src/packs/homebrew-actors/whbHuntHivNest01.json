          "value": []
        }
      }
    },
    {
      "_id": "whbHivFireWeak01",
      "img": "systems/pf2e/icons/actions/Passive.webp",
      "name": "惧火",
      "sort": 530000,
      "type": "action",
      "system": {
        "actionType": {
          "value": "passive"
        },
        "actions": {
          "value": null
        },
        "category": "defensive",
        "description": {
          "value": "<p>干枯躯壳与蜂巢易燃：对火焰伤害具有弱点 5。着火时胸腔内的蜂群也会躁动（GM 可让其立刻放出毒蜂，若场上尚无蜂群）。</p>"
        },
        "publication": {
