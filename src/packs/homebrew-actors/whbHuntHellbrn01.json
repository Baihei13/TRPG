      "allSaves": { "value": "" },
      "hp": {
        "details": "Wild Target；半血以下连射 4 发；死后立刻驱逐",
        "max": 100,
        "temp": 0,
        "value": 100
      },
      "speed": { "value": 30, "otherSpeeds": [] },
      "immunities": [{ "type": "fire" }],
      "weaknesses": [{ "type": "cold", "value": 5 }],
