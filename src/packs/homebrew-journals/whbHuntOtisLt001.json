              "strokes": []
            }
          },
          {
            "id": "page-6",
            "title": "信 · 其四（续）",
            "flowContent": "<div style=\"font-family:Georgia,'Songti SC',SimSun,serif;font-size:1.42rem;line-height:1.85;color:#1a120c;text-align:justify;\"><p style=\"margin:0 0 0.85rem;text-align:center;font-size:1.18rem;letter-spacing:0.35em;color:#6a4a30;opacity:0.85;\">✦ &nbsp;—&nbsp; ✦</p><p style=\"margin:0 0 0.75rem;font-size:1.2rem;line-height:1.5;color:#5a4030;font-style:italic;\">信 · 其四（续）</p><p style=\"margin:0 0 0.8rem;line-height:1.85;text-align:justify;\">奥蒂斯，如果你看到这条信息，请派人来帮忙。虽然天知道现在谁能帮我们，或者谁愿意帮我们。</p><p style=\"margin:0 0 0.8rem;line-height:1.85;text-align:justify;\">——A</p></div>",
            "textBlocks": [],
            "ruleBlocks": [],
            "imageBlocks": [],
            "styles": {},
